{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedControl",
  "mainBinaryName": "medcontrol",
  "version": "0.3.1",
  "identifier": "app.med-control.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Medical",
    "shortDescription": "Your whole treatment history, close at hand",
    "copyright": "MedControl authors, AGPL-3.0",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../build/app/": "app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
