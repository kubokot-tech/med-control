# .env необязателен: без него `docker compose up -d` поднимает базовый набор, а пароль задаётся
# на странице первого запуска. Здесь всё, что можно переопределить. Значения из .env важнее настроек из интерфейса.

# Postgres. Пароль по умолчанию `dtc`: база не публикуется наружу, но лучше сменить (см. чек-лист в docs/OPERATIONS.md).
POSTGRES_USER=dtc
POSTGRES_PASSWORD=dtc
POSTGRES_DB=dtc

# Вход (один пользователь, логина нет). Пусто: пароль задаётся на странице первого запуска и хранится в базе (хэш scrypt).
# Если задать DTC_PASSWORD здесь (лучше от 10 символов; короче 8 gateway не примет), мастер не показывается, а вход идёт по этим значениям.
#DTC_PASSWORD=
# Секрет подписи сессий. Пусто — создаётся сам в DATA_DIR/jwt.secret. Свой: openssl rand -base64 48
#JWT_SECRET=
JWT_TTL=30d

# URLs
DATABASE_URL=postgres://dtc:dtc@postgres:5432/dtc
INGESTION_URL=http://ingestion:8000
# Чем читать PDF: js (pdf.js и JS-версия парсеров лабораторий внутри gateway, по умолчанию) или python (сервис ingestion
# в запасе: включить ещё и профиль, COMPOSE_PROFILES=python). Тексты у обоих одинаковые; сравнить на своём бланке:
# docs/LAB-PARSERS.md, раздел «Два движка». Если python указан, а сервис не запущен, gateway читает PDF сам.
PDF_ENGINE=js

# Куда экран «Образец бланка» отправляет обезличенный текст бланка. Пусто: ничего не отправляется, на экране только копирование.
# LAB_SAMPLES_TOKEN нужен только мейнтейнеру для scripts/lab-samples.mjs, gateway его не читает.
LAB_SAMPLES_URL=
#LAB_SAMPLES_TOKEN=

# Доступ для внешних ИИ-агентов по MCP включается в Настройках; DTC_MCP=off запрещает его на этом сервере совсем (docs/MCP.md).
# DTC_MCP=off

# ИИ. Удобнее подключать в интерфейсе: Настройки → «Помощник ИИ» (или в мастере первого запуска); значения отсюда важнее.
# Сервисы: openrouter, anthropic, openai (ChatGPT), deepseek, yandex (YandexGPT / Алиса AI), gigachat, custom (свой адрес).
# Без LLM_PROVIDER берётся первый, чей ключ задан, в этом порядке. LLM_MODEL / LLM_MODEL_FAST пустые — модели сервиса по умолчанию.
OPENROUTER_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
# LLM_MODEL_FAST=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# YANDEX_API_KEY=            ключ сервисного аккаунта Yandex Cloud
# YANDEX_FOLDER_ID=          каталог Yandex Cloud
# GIGACHAT_AUTH_KEY=         ключ авторизации из кабинета разработчика Сбера (base64)
# GIGACHAT_SCOPE=GIGACHAT_API_PERS   (для юрлиц GIGACHAT_API_CORP)
# LLM_BASE_URL=http://192.168.1.10:11434/v1   свой OpenAI-совместимый адрес (Ollama, LM Studio)
# LLM_CUSTOM_API_KEY=

# Telegram-напоминания. Удобнее подключать в интерфейсе: Настройки → Telegram (токен бота, затем «Найти чат»); значения отсюда важнее.
# Через .env: создайте бота у @BotFather, вставьте токен, напишите боту «привет», затем в Настройках нажмите «Найти чат»
# и вставьте chat id сюда. APP_URL: адрес, по которому вы открываете МедКонтроль с телефона.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# На сервере: внешний адрес, например https://medcontrol.example.com (динамический DNS роутера, VPN или свой домен).
APP_URL=http://localhost:3001
# Время напоминаний меняется в Настройках → Telegram. Значения здесь важнее и закрепляют его (по часовому поясу пользователя).
#REMIND_DOSE_AT=11:00
#REMIND_DOSE_AGAIN_AT=20:00
#LAB_STALE_DAYS=28

# Где хранить данные. По умолчанию docker-volumes; на NAS или сервере удобнее обычные папки, чтобы их было видно по сети и они попадали в снимки:
#   DATA_DIR=/srv/medcontrol/data   PG_DIR=/srv/medcontrol/pgdata   BACKUP_DIR=/srv/medcontrol/backups
# BIND_ADDR=0.0.0.0 открывает порт 3001 для локальной сети (нужно на сервере: доступ через VPN или обратный прокси).
# ENABLE_DOCS=1 включает Swagger на /docs (только для разработки, наружу не публиковать).
# Второй фактор: passkey (Face ID / Touch ID) регистрируется в Настройках и после этого требуется при каждом входе.
# Домен и origin для WebAuthn берутся из APP_URL; WEBAUTHN_ORIGINS — дополнительные origin через запятую.
# DTC_MFA=off временно отключает шаг с ключом, если все ключи потеряны (после входа удалите старые ключи и добавьте новый).
DTC_MFA=on
WEBAUTHN_ORIGINS=
DATA_DIR=dtcdata
PG_DIR=pgdata
# Ночные копии. По умолчанию ../medcontrol-backups — папка рядом с папкой МедКонтроля, не внутри неё:
# если удалить папку с кодом и скачать заново, копии останутся. Лучше — папка на другом диске.
#BACKUP_DIR=../medcontrol-backups
BIND_ADDR=127.0.0.1
# Если BIND_ADDR или APP_URL не localhost, мастер первого запуска спросит код из журнала:
#   docker compose logs gateway | grep "Код первого запуска"
# DTC_SETUP_CODE=on|off включает или выключает этот код принудительно.
#DTC_SETUP_CODE=
# Порт на хосте (внутри контейнера всегда 3001).
#APP_PORT=3001
# Подсеть сети стека. Если меняете, поменяйте и Allow в egress/tinyproxy.conf.
#STACK_SUBNET=172.31.250.0/24
# Имя проекта Docker, только для старой установки, у которой тома названы по папке (docs/UPDATE.md).
#COMPOSE_PROJECT_NAME=
BACKUP_AT=03:30
BACKUP_KEEP=14
# Часовой пояс служб backup, watchdog и orthanc: по нему считается BACKUP_AT и ставится время в сообщениях сторожа.
# С поясом, выбранным в программе, он не связан. Впишите свой, например TZ=Europe/Berlin или TZ=America/New_York,
# и выполните docker compose up -d. Без этой строки службы работают по Europe/Moscow.
TZ=Europe/Moscow

# Выход к ИИ и Telegram через VPN роутера: некоторые сервисы ИИ и Telegram доступны не во всех странах и не у всех провайдеров.
# На сервере: COMPOSE_PROFILES=egress поднимает контейнер-прокси со своим адресом в домашней сети (macvlan),
# в роутере это устройство переводится на VPN (если роутер умеет маршрутизировать по устройствам), а gateway ходит через него.
# EGRESS_PARENT — сетевой интерфейс сервера (например, eth0), EGRESS_IP — свободный адрес в домашней сети. Значения ниже — пример.
#COMPOSE_PROFILES=egress
#EGRESS_PROXY=http://egress:8888
# Telegram отдельно от ИИ: TELEGRAM_PROXY=direct значит напрямую, без VPN (если Telegram у вашего провайдера доступен).
# Для сторожа то же: TELEGRAM_PROXY_WATCHDOG=direct.
#TELEGRAM_PROXY=direct
#TELEGRAM_PROXY_WATCHDOG=direct
#EGRESS_PARENT=eth0
#EGRESS_SUBNET=192.168.1.0/24
#EGRESS_GATEWAY=192.168.1.1
#EGRESS_IP=192.168.1.60
#EGRESS_MAC=02:dc:00:00:00:60

# DICOM-архив (Orthanc), профиль dicom: COMPOSE_PROFILES=dicom (через запятую с другими профилями). DICOM_DIR — папка с дисками (например, /srv/medcontrol/dicom), ORTHANC_DIR — хранилище Orthanc.
# ORTHANC_USER/PASSWORD — вход gateway и edge в Orthanc. Пользователь их не вводит: просмотрщик <APP_URL>/orthanc/
# открывается из раздела «Снимки» после входа в МедКонтроль. Пароль длинный и случайный: openssl rand -hex 24
#DICOM_DIR=/srv/medcontrol/dicom
#ORTHANC_DIR=/srv/medcontrol/orthanc
ORTHANC_USER=dtc
# Нужен для профиля dicom: без пароля Orthanc не стартует, а архив снимков в интерфейсе выключен.
ORTHANC_PASSWORD=

# Бэкапы. Ярус 1: ночной дамп в BACKUP_DIR (есть). Ярус 2: копия на второй диск MIRROR_DIR (например, /mnt/disk2/medcontrol-backup).
# Ярус 3: зашифрованная копия в облако через rclone. RCLONE_DIR: папка с rclone.conf. CLOUD_REMOTE: имя remote с двоеточием.
# scripts/cloud-setup.sh для примера настраивает одно S3-совместимое хранилище и remote yc-crypt:. Подойдёт любой remote rclone:
# положите свой rclone.conf в RCLONE_DIR. Чтобы копия была зашифрована, remote должен быть типа crypt.
# Копии ложатся в <CLOUD_REMOTE>/backups и <CLOUD_REMOTE>/dicom. Проверка восстановления по воскресеньям (RESTORE_TEST_DOW).
#MIRROR_DIR=/mnt/disk2/medcontrol-backup
#RCLONE_DIR=/srv/medcontrol/rclone
#CLOUD_REMOTE=yc-crypt:
RESTORE_TEST_DOW=Sun

# Сторож (профиль watchdog, COMPOSE_PROFILES=watchdog): контейнер раз в WATCHDOG_INTERVAL секунд опрашивает /health?deep=1 и пишет в Telegram,
# если МедКонтроль не отвечает или что-то деградировало. Токен и chat id Telegram для сторожа берутся только из .env. HEALTHCHECKS_URL — адрес «пинга» внешнего сервиса
# (healthchecks.io, uptimerobot heartbeat): если пинги перестанут приходить (сервер выключен, Docker упал), внешний сервис сам напишет.
WATCHDOG_INTERVAL=300
# Язык сообщений сторожа: ru или en. У сторожа нет доступа к настройкам пользователя, поэтому язык задаётся здесь.
#WATCHDOG_LANG=en
HEALTHCHECKS_URL=
